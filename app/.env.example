# Server
PORT=3000
# Where the SQLite database (recipes.db) and uploaded images (uploads/) live.
DATA_FOLDER=./data
JWT_SECRET=change-me

# LLM used to extract recipes, as <provider>:<model>. Providers: openai, anthropic, gemini.
# Only the key of the provider you pick is needed.
LLM_MODEL=openai:gpt-5-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Video transcripts (YouTube, TikTok, Instagram, X) with ElevenLabs speech-to-text.
ELEVENLABS_API_KEY=
# YouTube descriptions via the YouTube Data API v3 (YouTube blocks page scraping from servers).
YOUTUBE_API_KEY=
