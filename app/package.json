{
  "name": "recipit",
  "version": "2.0.0",
  "description": "Save recipes from the web, videos and files in a common format",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev --port 3000",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "RUN_LIVE_TESTS=1 node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run tests/live.test.ts",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@supadata/js": "1.4.0",
    "@tanstack/ai": "1.8.0",
    "@tanstack/ai-anthropic": "1.2.1",
    "@tanstack/ai-gemini": "1.3.0",
    "@tanstack/ai-openai": "1.2.0",
    "@tanstack/react-query": "5.108.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.7",
    "bcryptjs": "3.0.3",
    "bootstrap": "5.3.9",
    "bootstrap-icons": "1.13.2",
    "cheerio": "1.2.0",
    "heic-convert": "2.1.0",
    "jsonwebtoken": "9.0.3",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.0",
    "react-bootstrap": "2.10.10",
    "react-dom": "^19.2.0",
    "react-toastify": "11.2.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "0.5.0",
    "@types/heic-convert": "2.1.1",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "5.1.1"
  }
}
